FULL_BACKUP_RETENTION = 4   # 保留最近 4 次全量备份

# ---- AI 助手「拾墨」配置 ----
AI_ENABLED = True
AI_MAX_TOKENS = 1000
AI_TEMPERATURE = 0.7

# AI Provider 配置（支持多供应商）
# 请替换为自己的 API Key
